# Copy this file to ".env" and fill it in. Never commit .env to git.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

# --- MySQL ---
DB_NAME=stridex
DB_USER=stridex_user
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# --- URLs (used for CORS + payment redirects) ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# --- Payments ---
# "sandbox" = fake payment page for card/Koko/Mintpay/PayZ (safe for learning)
PAYMENT_MODE=sandbox

# --- LLM chat (optional: without a key the chat uses a built-in keyword fallback) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Stage 1: hosting / production settings (all optional while developing) ---
PENDING_ORDER_TTL_MINUTES=30
# When you deploy: DJANGO_DEBUG=False and fill these in
# DJANGO_ALLOWED_HOSTS=shop.example.com
# CSRF_TRUSTED_ORIGINS=https://shop.example.com
# CORS_ALLOWED_ORIGINS=https://shop.example.com
# BEHIND_PROXY=True
# PAYMENT_MODE=live

# --- Stage 2: email ---
SHOP_NAME=StrideX
# Where "new order" notices go (your own email). Leave empty to disable.
SHOP_ADMIN_EMAIL= shalaniabhisheka9@gmail.com
# console = print emails in the terminal (default). smtp = really send them.
EMAIL_MODE=console
# Only needed when EMAIL_MODE=smtp (example for Gmail with an "App Password"):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=yourshop@gmail.com
# EMAIL_HOST_PASSWORD=your-16-letter-app-password
# DEFAULT_FROM_EMAIL=StrideX <yourshop@gmail.com>
